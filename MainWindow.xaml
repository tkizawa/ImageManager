<Window x:Class="ImageManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ImageManager"
        xmlns:viewmodels="using:ImageManager.ViewModels"
        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
        mc:Ignorable="d">
    <Grid Margin="10" x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Uid="OpenFolderButton" Command="{Binding SelectFolderCommand}" Padding="10,5" />
                <DropDownButton x:Uid="SettingsButton" Margin="10,0,0,0" Padding="10,5">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="14"/>
                            <TextBlock x:Uid="SettingsText" />
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="ExportSettingsMenu" Command="{Binding ExportSettingsCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B9;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="ImportSettingsMenu" Command="{Binding ImportSettingsCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B8;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="HelpMenu" Click="HelpButton_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE897;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="HelpButton" Click="HelpButton_Click" Margin="10,0,0,0" Padding="10,5">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9CE;" FontSize="14"/>
                            <TextBlock x:Uid="HelpText" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button x:Name="ClassifyButton" Click="ClassifyButton_Click" Margin="10,0,0,0" Padding="10,5" Visibility="Collapsed">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="AI自動分類" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <TextBlock Text="{Binding CurrentFolderPath}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,5,0" />
        </Grid>

        <!-- Left Pane (Tabs) -->
        <TabView Grid.Row="1" Grid.Column="0" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <!-- フォルダタブ (ツリー) -->
            <TabViewItem x:Uid="FolderTab" IsClosable="False">
                <TreeView x:Name="FolderTreeView"
                          ItemsSource="{Binding Folders}"
                          ItemInvoked="FolderTreeView_ItemInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <TextBlock Text="{Binding Name}">
                                    <TextBlock.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="AddToFavoritesMenu" 
                                                            Click="AddFavoriteFolder_Click" 
                                                            Tag="{Binding}" />
                                        </MenuFlyout>
                                    </TextBlock.ContextFlyout>
                                </TextBlock>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </TabViewItem>

            <!-- お気に入りタブ -->
            <TabViewItem x:Uid="FavoritesTab" IsClosable="False">
                <ListView ItemsSource="{Binding FavoriteFolders}" 
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="FavoriteListView_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,5" ToolTipService.ToolTip="{Binding}">
                                <TextBlock Text="{Binding Converter={StaticResource PathToFolderNameConverter}}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="OpenMenu" 
                                                            Click="OpenFavoriteFolder_Click" 
                                                            Tag="{Binding}" />
                                            <MenuFlyoutItem x:Uid="RemoveFromFavoritesMenu" 
                                                            Click="RemoveFavoriteFolder_Click" 
                                                            Tag="{Binding}" />
                                        </MenuFlyout>
                                    </TextBlock.ContextFlyout>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <!-- 履歴タブ -->
            <TabViewItem x:Uid="HistoryTab" IsClosable="False">
                <ListView ItemsSource="{Binding HistoryFolders}" 
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="HistoryListView_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,5" ToolTipService.ToolTip="{Binding}">
                                <TextBlock Text="{Binding Converter={StaticResource PathToFolderNameConverter}}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="OpenMenu" 
                                                            Click="OpenHistoryFolder_Click" 
                                                            Tag="{Binding}" />
                                            <MenuFlyoutItem x:Uid="AddToFavoritesMenu" 
                                                            Click="AddFavoriteFolder_Click" 
                                                            Tag="{Binding}" />
                                            <MenuFlyoutItem x:Uid="RemoveFromHistoryMenu" 
                                                            Click="RemoveHistoryFolder_Click" 
                                                            Tag="{Binding}" />
                                        </MenuFlyout>
                                    </TextBlock.ContextFlyout>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>
        </TabView>

        <!-- Splitter 1 -->
        <Thumb Grid.Row="1" Grid.Column="1" Width="11" x:Name="TreeSplitter" Background="Transparent" DragDelta="TreeSplitter_DragDelta" Loaded="Splitter_Loaded" />

        <!-- Thumbnail Area -->
        <Grid Grid.Row="1" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="10,5,10,5" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <TextBlock x:Uid="SortByText" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox SelectedIndex="{Binding SortFieldIndex, Mode=TwoWay}" Width="120" Margin="0,0,10,0">
                    <ComboBoxItem x:Uid="SortModifiedDate" />
                    <ComboBoxItem x:Uid="SortTakenDate" />
                </ComboBox>
                <ComboBox SelectedIndex="{Binding SortDirectionIndex, Mode=TwoWay}" Width="100">
                    <ComboBoxItem x:Uid="SortAscending" />
                    <ComboBoxItem x:Uid="SortDescending" />
                </ComboBox>
            </StackPanel>

            <!-- Thumbnail Grid -->
            <GridView Grid.Row="1" x:Name="ThumbnailGridView"
                      ItemsSource="{Binding Images}" 
                      SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                      DoubleTapped="ThumbnailGridView_DoubleTapped"
                      Padding="5">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5" Width="{Binding DataContext.ThumbnailPanelWidth, ElementName=RootGrid}">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="OpenWithPhotosMenu" Click="OpenWithPhotos_Click" Tag="{Binding}" />
                                    <MenuFlyoutItem x:Uid="ShowInExplorerMenu" Click="ShowInExplorer_Click" Tag="{Binding}" />
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Image Source="{Binding FilePath, Converter={StaticResource StringToImageSourceConverter}}" 
                                   Width="{Binding DataContext.ThumbnailSize, ElementName=RootGrid}" 
                                   Height="{Binding DataContext.ThumbnailSize, ElementName=RootGrid}" 
                                   Stretch="Uniform" />
                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FileName}" TextAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
        
        <!-- Splitter 2 -->
        <Thumb Grid.Row="1" Grid.Column="3" Width="11" x:Name="PreviewSplitter" Background="Transparent" DragDelta="PreviewSplitter_DragDelta" Loaded="Splitter_Loaded" />

        <!-- Preview and Properties -->
        <Border Grid.Row="1" Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock x:Uid="PreviewText" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                    <Image Source="{Binding SelectedImage.FilePath, Converter={StaticResource StringToImageSourceConverter}}" MaxHeight="300" Stretch="Uniform" Margin="0,0,0,20" />
                    
                    <TextBlock x:Uid="PropertiesText" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="FileNameText" FontWeight="SemiBold" Margin="0,0,10,5" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedImage.FileName}" TextWrapping="Wrap" Margin="0,0,0,5" />

                        <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="FileSizeText" FontWeight="SemiBold" Margin="0,0,10,5" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedImage.FileSize}" Margin="0,0,0,5" />

                        <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="FileModifiedDateText" FontWeight="SemiBold" Margin="0,0,10,5" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedImage.LastWriteTime}" Margin="0,0,0,5" />
                        
                        <!-- EXIF Info -->
                        <TextBlock Grid.Row="3" Grid.Column="0" x:Uid="DateTakenText" FontWeight="SemiBold" Margin="0,10,10,5" Visibility="{Binding SelectedImage.DateTaken, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedImage.DateTaken}" Margin="0,10,0,5" Visibility="{Binding SelectedImage.DateTaken, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" x:Uid="CameraText" FontWeight="SemiBold" Margin="0,0,10,5" Visibility="{Binding SelectedImage.CameraModel, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedImage.CameraModel}" Margin="0,0,0,5" Visibility="{Binding SelectedImage.CameraModel, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" x:Uid="LensText" FontWeight="SemiBold" Margin="0,0,10,5" Visibility="{Binding SelectedImage.Lens, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedImage.Lens}" Margin="0,0,0,5" Visibility="{Binding SelectedImage.Lens, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" x:Uid="FNumberText" FontWeight="SemiBold" Margin="0,0,10,5" Visibility="{Binding SelectedImage.FNumber, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedImage.FNumber}" Margin="0,0,0,5" Visibility="{Binding SelectedImage.FNumber, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" x:Uid="ExposureTimeText" FontWeight="SemiBold" Margin="0,0,10,5" Visibility="{Binding SelectedImage.ExposureTime, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedImage.ExposureTime}" Margin="0,0,0,5" Visibility="{Binding SelectedImage.ExposureTime, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" x:Uid="IsoText" FontWeight="SemiBold" Margin="0,0,10,5" Visibility="{Binding SelectedImage.IsoSpeed, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedImage.IsoSpeed}" Margin="0,0,0,5" Visibility="{Binding SelectedImage.IsoSpeed, Converter={StaticResource StringToVisibilityConverter}}" />
                        
                        <TextBlock Grid.Row="9" Grid.Column="0" x:Uid="FocalLengthText" FontWeight="SemiBold" Margin="0,0,10,5" Visibility="{Binding SelectedImage.FocalLength, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedImage.FocalLength}" Margin="0,0,0,5" Visibility="{Binding SelectedImage.FocalLength, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="カテゴリー:" FontWeight="SemiBold" Margin="0,10,10,5" Visibility="{Binding SelectedImage.Category, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedImage.Category}" Margin="0,10,0,5" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding SelectedImage.Category, Converter={StaticResource StringToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

<ContentDialog
    x:Class="ImageManager.CacheManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="サムネイルのキャッシュ管理"
    PrimaryButtonText="保存"
    CloseButtonText="閉じる"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="520">
        <TextBlock Text="サムネイル画像のキャッシュ管理とアプリ終了時の自動削除設定を行います。"
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />

        <!-- Section 1: Cache Status & Bulk Clear -->
        <TextBlock Text="現在のキャッシュ状況:" FontWeight="SemiBold" FontSize="14" />
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="14">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="保存先フォルダ:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CachePathTextBlock" FontSize="12" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="OpenCacheFolder_Click" Margin="8,0,0,0" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                            <TextBlock Text="フォルダを開く" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="現在の使用量:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CacheUsageTextBlock" Text="計算中..." FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="ClearAllCache_Click" Padding="12,6" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="キャッシュを一括削除" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar x:Name="ActionResultInfoBar" IsOpen="False" Severity="Success" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Section 2: Auto-clean Settings on Exit -->
        <TextBlock Text="終了時の自動削除設定:" FontWeight="SemiBold" FontSize="14" />
        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="14">
            <StackPanel Spacing="12">
                <CheckBox x:Name="AutoCleanCheckBox" Content="アプリ終了時にキャッシュの自動削除を行う" Checked="AutoCleanCheckBox_Changed" Unchecked="AutoCleanCheckBox_Changed" FontWeight="SemiBold" />

                <StackPanel x:Name="AutoCleanOptionsPanel" Spacing="10" Margin="24,0,0,0">
                    <!-- Period Selection -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="経過期間による削除:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="PeriodComboBox" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="指定なし（経過日数で削除しない）" Tag="0" />
                            <ComboBoxItem Content="7日以上経過した古いキャッシュを削除" Tag="7" />
                            <ComboBoxItem Content="14日以上経過した古いキャッシュを削除" Tag="14" />
                            <ComboBoxItem Content="30日以上経過した古いキャッシュを削除" Tag="30" />
                            <ComboBoxItem Content="60日以上経過した古いキャッシュを削除" Tag="60" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Capacity Selection -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="容量上限による削除:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="CapacityComboBox" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="指定なし（容量で削除しない）" Tag="0" />
                            <ComboBoxItem Content="1 GB を超過した場合に古い順に削除" Tag="1073741824" />
                            <ComboBoxItem Content="5 GB を超過した場合に古い順に削除" Tag="5368709120" />
                            <ComboBoxItem Content="10 GB を超過した場合に古い順に削除" Tag="10737418240" />
                        </ComboBox>
                    </StackPanel>
                    
                    <TextBlock Text="※アプリ終了時に条件を判定し、削除対象がある場合はメッセージを表示して削除します。"
                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>

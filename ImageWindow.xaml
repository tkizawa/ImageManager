<Window
    x:Class="ImageManager.ImageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ImageManager"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" 
          Background="#1E1E1E" 
          KeyboardAcceleratorPlacementMode="Hidden"
          ToolTipService.ToolTip="右クリックで画像情報の表示・非表示の切り替え">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <ToggleMenuFlyoutItem x:Name="ToggleInfoMenuItem" 
                                       Text="写真情報を表示" 
                                       IsChecked="True"
                                       Click="ToggleInfoMenuItem_Click" />
                <MenuFlyoutItem x:Name="ToggleFavoriteMenuItem"
                                Text="お気に入りの切り替え (F)"
                                Click="ToggleFavoriteMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE735;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Right" Invoked="NextImage_Invoked" />
            <KeyboardAccelerator Key="Left" Invoked="PreviousImage_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="CloseWindow_Invoked" />
            <KeyboardAccelerator Key="I" Invoked="ToggleInfoOverlay_Invoked" />
            <KeyboardAccelerator Key="F" Invoked="ToggleFavorite_Invoked" />
        </Grid.KeyboardAccelerators>
        
        <Image x:Name="FullImage" 
               Stretch="Uniform" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               Margin="10"
               PointerWheelChanged="Image_PointerWheelChanged"
               PointerPressed="Image_PointerPressed"
               PointerMoved="Image_PointerMoved"
               PointerReleased="Image_PointerReleased"
               PointerCanceled="Image_PointerReleased">
            <Image.RenderTransform>
                <CompositeTransform x:Name="ImageTransform" />
            </Image.RenderTransform>
        </Image>

        <!-- Top-Left Information Overlay -->
        <Border x:Name="InfoOverlayBorder"
                Visibility="Visible"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="20"
                Padding="16,12"
                CornerRadius="8"
                Background="#D0181818"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                MaxWidth="500"
                IsHitTestVisible="False">
            <StackPanel Spacing="6">
                <!-- Header / File Name -->
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="📄" Margin="0,0,8,0" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" 
                               Text="{Binding SelectedImage.FileName}" 
                               FontWeight="Bold" 
                               FontSize="14" 
                               Foreground="White" 
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Date Taken -->
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="📅 撮影日:" Margin="0,0,8,0" FontSize="12" Foreground="#B0B0B0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" 
                               Text="{Binding SelectedImage.FormattedDateTaken}" 
                               FontSize="12" 
                               Foreground="#E0E0E0" 
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Favorite Status -->
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="⭐ お気に入り:" Margin="0,0,8,0" FontSize="12" Foreground="#B0B0B0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" 
                               Text="{Binding SelectedImage.IsFavorite, Converter={StaticResource BoolToStarGlyphConverter}}" 
                               FontSize="14" 
                               Foreground="{Binding SelectedImage.IsFavorite, Converter={StaticResource BoolToStarBrushConverter}}" />
                </Grid>

                <!-- EXIF Information -->
                <StackPanel Spacing="4" Margin="0,2,0,0">
                    <!-- Camera Model -->
                    <Grid ColumnDefinitions="Auto,*" Visibility="{Binding SelectedImage.CameraModel, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="📷 カメラ:" Margin="0,0,8,0" FontSize="12" Foreground="#B0B0B0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding SelectedImage.CameraModel}" 
                                   FontSize="12" 
                                   Foreground="#E0E0E0" 
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- Lens Model -->
                    <Grid ColumnDefinitions="Auto,*" Visibility="{Binding SelectedImage.Lens, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="🔍 レンズ:" Margin="0,0,8,0" FontSize="12" Foreground="#B0B0B0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding SelectedImage.Lens}" 
                                   FontSize="12" 
                                   Foreground="#E0E0E0" 
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- Exposure Parameters -->
                    <Grid ColumnDefinitions="Auto,*" Visibility="{Binding SelectedImage.FormattedExposureSpecs, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="⚙️ 設定:" Margin="0,0,8,0" FontSize="12" Foreground="#B0B0B0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding SelectedImage.FormattedExposureSpecs}" 
                                   FontSize="12" 
                                   Foreground="#E0E0E0" 
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- File Size -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="💾 サイズ:" Margin="0,0,8,0" FontSize="12" Foreground="#B0B0B0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding SelectedImage.FormattedFileSize}" 
                                   FontSize="12" 
                                   Foreground="#B0B0B0" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<ContentDialog
    x:Class="ImageManager.ExternalAppsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="外部プログラムの設定"
    CloseButtonText="閉じる"
    DefaultButton="Close">

    <StackPanel Spacing="16" Width="520">
        <TextBlock Text="画像ファイルを右クリックした際に呼び出せる外部プログラム（Photoshop, GIMP, ペイント等）を設定します。"
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />

        <!-- Registered External Apps List -->
        <TextBlock Text="登録済みの外部プログラム:" FontWeight="SemiBold" FontSize="14" />

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                MinHeight="120"
                MaxHeight="220">
            <Grid>
                <ListView x:Name="AppsListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7AC;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" 
                                        Click="DeleteApp_Click" 
                                        Tag="{Binding}" 
                                        ToolTipService.ToolTip="削除"
                                        Padding="6,6"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyListTextBlock" 
                           Text="登録されている外部プログラムはありません" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Add New App Section -->
        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="新しい外部プログラムを追加" FontWeight="SemiBold" FontSize="13" />

                <!-- Program Name -->
                <TextBox x:Name="ProgramNameTextBox" Header="プログラム表示名" PlaceholderText="例: Adobe Photoshop, GIMP, ペイント" />

                <!-- Executable Path with Browse Button -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="実行ファイルパス (.exe)" FontSize="12" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <TextBox x:Name="ExecutablePathTextBox" PlaceholderText="C:\Program Files\..." />
                        <Button Grid.Column="1" Content="参照..." Margin="8,0,0,0" Click="BrowseExecutable_Click" Padding="12,5" />
                    </Grid>
                </Grid>

                <!-- Arguments (Optional) -->
                <TextBox x:Name="ArgumentsTextBox" 
                         Header="起動引数（省略時は画像ファイルのパス）" 
                         PlaceholderText="{}{path}" 
                         Text="{}{path}" />

                <Button Content="プログラムを追加" 
                        Click="AddProgram_Click" 
                        Style="{ThemeResource AccentButtonStyle}" 
                        HorizontalAlignment="Right"
                        Padding="16,6" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
